+// sophgo custom features
+
+inline void getSophgoCpldProperty(
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+    const std::string& propertyName, const std::string& jsonKey)
+{
+    sdbusplus::asio::getProperty<std::string>(
+        *crow::connections::systemBus, "xyz.openbmc_project.State.Host",
+        "/xyz/openbmc_project/state/host0", "xyz.openbmc_project.State.Host",
+        propertyName,
+        [asyncResp, jsonKey](const boost::system::error_code& ec,
+                             const std::string& value) {
+        if (ec)
+        {
+            if (ec != boost::system::errc::host_unreachable)
+            {
+                BMCWEB_LOG_ERROR("DBUS response error {}", ec.value());
+            }
+            return;
+        }
+        asyncResp->res.jsonValue[jsonKey] = value;
+    });
+}
+
+inline void getSophgoCpldInfo(
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)
+{
+    getSophgoCpldProperty(asyncResp, "CurrentCPUAPWState", "CpuaPWInfo");
+    getSophgoCpldProperty(asyncResp, "CurrentCPUBPWState", "CpubPWInfo");
+    getSophgoCpldProperty(asyncResp, "CurrentCPUOtherPWState", "CpuoPWInfo");
+    getSophgoCpldProperty(asyncResp, "CurrentOtherPWState", "OtherPWInfo");
+    getSophgoCpldProperty(asyncResp, "CurrentPSUState", "PsuInfo");
+    getSophgoCpldProperty(asyncResp, "CurrentEFUState", "EfusInfo");
+}
+
+inline void getSophgoCpldVersion(
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)
+{
+    sdbusplus::asio::getProperty<std::string>(
+        *crow::connections::systemBus, "xyz.openbmc_project.State.CPLD",
+        "/xyz/openbmc_project/state/cpld/softVersion",
+        "xyz.openbmc_project.State.Cpld.Version", "VERSION",
+        [asyncResp](const boost::system::error_code& ec,
+                    const std::string& version) {
+        if (ec)
+        {
+            if (ec != boost::system::errc::host_unreachable)
+            {
+                BMCWEB_LOG_ERROR("DBUS response error {}", ec.value());
+            }
+            return;
+        }
+        asyncResp->res.jsonValue["CpldInfo"] = version;
+    });
+}
+
+inline void getSophgoFanSpeed(
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)
+{
+    sdbusplus::asio::getProperty<std::string>(
+        *crow::connections::systemBus, "xyz.openbmc_project.FanControl",
+        "/xyz/openbmc_project/sophgo/fanControl",
+        "xyz.openbmc_project.Sophgo.FanControl", "ControlMode",
+        [asyncResp](const boost::system::error_code& ec,
+                    const std::string& mode) {
+        if (ec)
+        {
+            BMCWEB_LOG_DEBUG("DBUS response error {}", ec.value());
+            return;
+        }
+        asyncResp->res.jsonValue["FanSpeed"] = mode;
+    });
+}
+
+inline void setSophgoFanSpeed(
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+    const std::string& fanSpeed)
+{
+    crow::connections::systemBus->async_method_call(
+        [asyncResp](const boost::system::error_code& ec) {
+        if (ec)
+        {
+            messages::internalError(asyncResp->res);
+        }
+        },
+        "xyz.openbmc_project.FanControl",
+        "/xyz/openbmc_project/sophgo/fanControl",
+        "org.freedesktop.DBus.Properties", "Set",
+        "xyz.openbmc_project.Sophgo.FanControl", "ControlMode",
+        dbus::utility::DbusVariantType(fanSpeed));
+}
+
+inline void getSophgoSg1684xInfo(
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)
+{
+    sdbusplus::asio::getProperty<double>(
+        *crow::connections::systemBus, "xyz.openbmc_project.FanControl",
+        "/xyz/openbmc_project/sensors/temperature/AiCard_Temp",
+        "xyz.openbmc_project.Sensor.Value", "Value",
+        [asyncResp](const boost::system::error_code& ec, double tmpValue) {
+        if (ec)
+        {
+            if (ec != boost::system::errc::host_unreachable)
+            {
+                BMCWEB_LOG_ERROR("DBUS response error {}", ec.value());
+            }
+            return;
+        }
+        asyncResp->res.jsonValue["sg1684xTmpInfo"] = tmpValue;
+    });
+    sdbusplus::asio::getProperty<int>(
+        *crow::connections::systemBus, "xyz.openbmc_project.FanControl",
+        "/xyz/openbmc_project/sensors/temperature/AiCard_Temp",
+        "xyz.openbmc_project.Sensor.Value", "sg1684xExistState",
+        [asyncResp](const boost::system::error_code& ec, int isExist) {
+        if (ec)
+        {
+            if (ec != boost::system::errc::host_unreachable)
+            {
+                BMCWEB_LOG_ERROR("DBUS response error {}", ec.value());
+            }
+            return;
+        }
+        asyncResp->res.jsonValue["sg1684xInfo"] =
+            isExist ? "Exist" : "absent";
+    });
+}
+
+inline void handleSophgoChangeSolPort(
+    crow::App& app, const crow::Request& req,
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)
+{
+    if (!redfish::setUpRedfishRoute(app, req, asyncResp))
+    {
+        return;
+    }
+    std::string solPortType;
+    if (!json_util::readJsonAction(req, asyncResp->res, "SolPortType",
+                                   solPortType))
+    {
+        return;
+    }
+    std::string command;
+    if (solPortType == "port0") { command = "CPU0UART0"; }
+    else if (solPortType == "port1") { command = "CPU0UART1"; }
+    else if (solPortType == "port2") { command = "CPU1UART0"; }
+    else if (solPortType == "port3") { command = "CPU1UART1"; }
+    else
+    {
+        messages::actionParameterUnknown(asyncResp->res, "ChangeSolPort",
+                                         solPortType);
+        return;
+    }
+    crow::connections::systemBus->async_method_call(
+        [asyncResp, solPortType](const boost::system::error_code& ec) {
+        if (ec)
+        {
+            BMCWEB_LOG_ERROR("D-Bus responses error: {}", ec.value());
+            if (ec.value() == boost::asio::error::invalid_argument)
+            {
+                messages::actionParameterNotSupported(
+                    asyncResp->res, solPortType, "ChangeSolPort");
+            }
+            else
+            {
+                messages::internalError(asyncResp->res);
+            }
+        }
+        },
+        "xyz.openbmc_project.Console",
+        "/xyz/openbmc_project/console/default",
+        "org.freedesktop.DBus.Properties", "Set",
+        "xyz.openbmc_project.Console.Access", "SOLPort",
+        dbus::utility::DbusVariantType(command));
+}
+
+inline void handleSophgoSolLogsGet(
+    crow::App& app, const crow::Request& req,
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)
+{
+    if (!redfish::setUpRedfishRoute(app, req, asyncResp))
+    {
+        return;
+    }
+    std::ifstream logFile("/var/log/obmc-console.log",
+                          std::ios::in | std::ios::binary);
+    if (logFile)
+    {
+        std::ostringstream contents;
+        contents << logFile.rdbuf();
+        logFile.close();
+        asyncResp->res.addHeader(boost::beast::http::field::content_type,
+                                 "text/plain");
+        asyncResp->res.write(contents.str());
+    }
+    else
+    {
+        messages::resourceNotFound(asyncResp->res, "Log file",
+                                   "/var/log/obmc-console.log");
+    }
+}
+
